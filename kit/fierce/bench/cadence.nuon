# The frame's cadence on Render Zero, in your window with live audio:
# your own play first, then the gauge's route in two batches of three
# seeded runs. `./do bench kit/fierce/cadence` runs it,
# `nu/bin/nuance.nu watch bench kit/fierce/cadence` in a second terminal
# records every run of it.
{
  summary: "the program's cadence: your play, then the route twice, in your window with live audio"
  tree: "release"
  steps: [
    { label: "play1", attend: "your turn: play Render Zero with your pad for 60 seconds, each frame shown as soon as it is ready", run: ["nu/bin/nuance.nu" "gauge" "play" "--tree" "release" "--seconds" "60" "--cadence" "1"] }
    { label: "cadence1_1", run: ["nu/bin/nuance.nu" "gauge" "run" "--tree" "release" "--runs" "3" "--host" "--cadence" "1"] }
    { label: "cadence1_2", run: ["nu/bin/nuance.nu" "gauge" "run" "--tree" "release" "--runs" "3" "--host" "--cadence" "1"] }
  ]
  report: ["nu/bin/nuance.nu" "gauge" "bench-report"]
}
