# g1_reload: the G-1's magazine out and a fresh one in, 0.9 seconds: a
# square-and-triangle clack at the start, a short noise scrape after it,
# a noise slide rising into a heavier, lower clack at half a second as
# the magazine seats.
{
    seconds: 0.9,
    layers: [
        [wave, start, frequency, sweep, gain, attack, decay, sustain, release];
        [square, 0.0, 820.0, 820.0, 0.24, 0.0, 0.03, 0.0, 0.0],
        [triangle, 0.0, 2300.0, 2300.0, 0.15, 0.0, 0.02, 0.0, 0.0],
        [noise, 0.0, 0.0, 0.0, 0.18, 0.0, 0.008, 0.0, 0.0],
        [noise, 0.0, 0.0, 0.0, 0.05, 0.02, 0.12, 0.0, 0.0],
        [noise, 0.0, 0.0, 0.0, 0.10, 0.44, 0.04, 0.0, 0.0],
        [square, 0.5, 560.0, 560.0, 0.28, 0.0, 0.035, 0.0, 0.0],
        [triangle, 0.5, 1700.0, 1700.0, 0.18, 0.0, 0.03, 0.0, 0.0],
        [noise, 0.5, 0.0, 0.0, 0.22, 0.0, 0.01, 0.0, 0.0],
    ],
}
