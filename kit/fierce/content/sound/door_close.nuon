# door_close: a steel door's motor closing it, 0.9 seconds: the same low
# hum as door_open sweeping slightly down, fading over the last 0.2
# seconds, and a heavier thud at 0.8 seconds as it meets the frame, a
# sine sinking from 69 to 60 hertz with a square body, a noise impact,
# and a triangle clank.
{
    seconds: 0.9,
    layers: [
        [wave, start, frequency, sweep, gain, attack, decay, sustain, release];
        [saw, 0.0, 118.0, 92.0, 0.20, 0.08, 0.0, 1.0, 0.2],
        [sine, 0.0, 236.0, 184.0, 0.12, 0.08, 0.0, 1.0, 0.2],
        [square, 0.0, 59.0, 46.0, 0.06, 0.10, 0.0, 1.0, 0.2],
        [noise, 0.0, 0.0, 0.0, 0.035, 0.12, 0.0, 1.0, 0.2],
        [sine, 0.8, 69.0, 60.0, 0.32, 0.0, 0.09, 0.0, 0.0],
        [square, 0.8, 190.0, 190.0, 0.12, 0.0, 0.04, 0.0, 0.0],
        [noise, 0.8, 0.0, 0.0, 0.16, 0.0, 0.018, 0.0, 0.0],
        [triangle, 0.8, 820.0, 820.0, 0.07, 0.0, 0.025, 0.0, 0.0],
    ],
}
