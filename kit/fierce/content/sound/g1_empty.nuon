        [triangle, 0.0, 2400.0, 2200.0, 0.28, 0.0, 0.010, 0.0, 0.0],
        [triangle, 0.0, 950.0, 900.0, 0.18, 0.0, 0.022, 0.0, 0.0],
    ],
}
