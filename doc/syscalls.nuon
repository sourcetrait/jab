# Jab system calls: the table of record. The number goes in a7, each
# argument in the register named, then `ecall`; the result comes back in
# a0, and a second one in a1 where a call has two. `kind` is how the SDK
# macro takes the argument: immediate (a constant, checked where a range
# exists), address (a label), or register (the program loads it before
# the call). sdk/src/jab.inc carries the same numbers under the jab.sys.*
# macros, every one a trap into the kernel; the mathematics of
# jab_f32.inc, jab_f64.inc, and jab_rng.inc beside it is carried code
# the program expands in place and never traps, and jab_jobs.inc's job
# mailboxes trap only in their waits, through jab.sys.worker.wait.
# Every call is made on
# hart 0, where the program runs, except on a worker's hart: a worker
# may call jab.sys.harts, jab.sys.worker.wait, jab.sys.worker.wake, and
# jab.sys.worker.exit, and any other call it makes answers JAB_DENIED,
# all ones, and does nothing.
[
    [name, number, args, summary];
    [jab.sys.exit, 1, [{name: status, kind: immediate, reg: a0}], "End the program with a status, every running worker stopped where it is first; QEMU exits with it until a launcher exists, or with 1 when a worker faulted as the program ended"],
    [jab.sys.print, 2, [{name: message, kind: address, reg: a0}], "Write a NUL-terminated string inside the program's window to the screen console once the display is open, else to the UART"],
    [jab.sys.uart.print, 3, [{name: message, kind: address, reg: a0}], "Write a NUL-terminated string inside the program's window to the UART"],
    [jab.sys.display.open, 4, [], "Bring the display up and show the framebuffer; 0, or 1 with no virtio-gpu, 2 when the device refuses the kernel, 3 when a command fails"],
    [jab.sys.display.ready, 5, [], "1 when a flip would go through now, 0 while the cap holds it back"],
    [jab.sys.display.flip, 6, [], "Show the framebuffer without waiting; 0, or 1 when early under the cap (nothing shown), 2 when not open, 3 when the device refused"],
    [jab.sys.display.print, 7, [{name: message, kind: address, reg: a0}], "Write a NUL-terminated string inside the program's window to the screen console, opening the display if needed; 0, or jab.sys.display.open's code"],
    [jab.sys.await, 8, [{name: mask, kind: immediate, reg: a0}], "Halt until an event in the mask, the inputs the program reads and the display's tick, nothing else: the display's frame tick (1), a key event (2), bytes from the host over the API (4), a pad event (8), room in the sound stream (16); a source the machine lacks drops out of the mask; the events that fired, 0 when nothing in the mask can happen, at once for a mask of 0"],
    [jab.sys.display.flip.rect, 9, [{name: x, kind: register, reg: a0}, {name: y, kind: register, reg: a1}, {name: width, kind: register, reg: a2}, {name: height, kind: register, reg: a3}], "Show a rectangle of the framebuffer without waiting; jab.sys.display.flip's codes, plus 4 when the rectangle is empty or reaches outside the screen"],
    [jab.sys.keyboard.input, 10, [], "The next key event: its code (Linux's, sdk/src/jab_keys.inc) in a0, or 0 with none waiting, and its value in a1, 0 released, 1 pressed, 2 held; brings the keyboard up on the first call"],
    [jab.sys.block.list, 11, [{name: buffer, kind: register, reg: a0}, {name: at, kind: register, reg: a1}, {name: capacity, kind: immediate, reg: a2}], "Write a record per disk into the buffer, starting at the disk with that id and 0 for the first; the records written, and in a1 the id to start the next page at, 0 once the last disk is in the buffer"],
    [jab.sys.block.find, 12, [{name: serial, kind: address, reg: a0}], "The id of the first disk whose serial is that NUL-terminated string, or 0 when no disk carries it"],
    [jab.sys.block.read, 13, [{name: buffer, kind: register, reg: a0}, {name: id, kind: register, reg: a1}, {name: sector, kind: register, reg: a2}, {name: count, kind: register, reg: a3}], "Read that many 512-byte sectors of that disk, from that one, into the buffer; 0, or 1 no such disk, 2 it would not come up, 3 the device reported an error, 4 those sectors are not on it"],
    [jab.sys.block.write, 14, [{name: buffer, kind: register, reg: a0}, {name: id, kind: register, reg: a1}, {name: sector, kind: register, reg: a2}, {name: count, kind: register, reg: a3}], "Write that many 512-byte sectors of the buffer to that disk, from that one; jab.sys.block.read's codes"],
    [jab.sys.romfs.list, 15, [{name: buffer, kind: register, reg: a0}, {name: id, kind: register, reg: a1}, {name: directory, kind: register, reg: a2}, {name: offset, kind: register, reg: a3}, {name: capacity, kind: immediate, reg: a4}], "Write a record per entry of that directory into the buffer, from that offset and 0 for its first entry; the records written, and in a1 the offset to start the next page at, 0 once the directory has ended"],
    [jab.sys.romfs.find, 16, [{name: buffer, kind: register, reg: a0}, {name: id, kind: register, reg: a1}, {name: directory, kind: register, reg: a2}, {name: path, kind: address, reg: a3}], "Look for that path from that directory, a leading / starting at the root, and write the entry's record into the buffer; 0 found, 1 nothing of that name, 2 a component along the way is not a directory, with the entry's own offset in a1"],
    [jab.sys.romfs.read, 17, [{name: buffer, kind: register, reg: a0}, {name: id, kind: register, reg: a1}, {name: file, kind: register, reg: a2}, {name: offset, kind: register, reg: a3}, {name: length, kind: register, reg: a4}], "Read at most that many bytes of that file, from that byte of it, into the buffer; the bytes written, and in a1 the offset to read from next, 0 at the file's end"],
    [jab.sys.tar.list, 18, [{name: buffer, kind: register, reg: a0}, {name: archive, kind: register, reg: a1}, {name: length, kind: register, reg: a2}, {name: offset, kind: register, reg: a3}, {name: capacity, kind: immediate, reg: a4}], "Write a record per entry of a tar archive the program already holds into the buffer, from that header's offset and 0 for the first; the records written, and in a1 the offset to start the next page at, 0 once the archive has ended"],
    [jab.sys.tar.find, 19, [{name: buffer, kind: register, reg: a0}, {name: archive, kind: register, reg: a1}, {name: length, kind: register, reg: a2}, {name: path, kind: address, reg: a3}], "Look for that path in the archive and write its record into the buffer, the path read no further than the window's end; 0 found or 1 no such name, with the entry's own offset in a1"],
    [jab.sys.gz.size, 20, [{name: source, kind: register, reg: a0}, {name: length, kind: register, reg: a1}], "The length a gzip's contents will be, from its trailer; a1 JAB_GZ_OK or JAB_GZ_NOT_GZIP"],
    [jab.sys.gz.read, 21, [{name: buffer, kind: register, reg: a0}, {name: source, kind: register, reg: a1}, {name: length, kind: register, reg: a2}, {name: capacity, kind: register, reg: a3}], "Inflate a gzip into the buffer in one call, its CRC-32 and length checked; the bytes written, and a JAB_GZ_* code in a1"],
    [jab.sys.checksum, 22, [{name: bytes, kind: register, reg: a0}, {name: size, kind: register, reg: a1}], "The SHA3-256 of those bytes, in a0 to a3"],
    [jab.sys.hash, 23, [{name: bytes, kind: register, reg: a0}, {name: size, kind: register, reg: a1}], "The XXH3-64 of those bytes"],
    [jab.sys.api.write, 24, [{name: buffer, kind: register, reg: a0}, {name: length, kind: register, reg: a1}], "Send that many bytes of the buffer to the host over the API, returning once the device has taken them; 0, or 1 when the machine has no API port, or 2 when the send was interrupted, the device behind the port having stopped answering, a prefix of the bytes perhaps already at the host and nothing promised about how many, every later write answering 1"],
    [jab.sys.api.read, 25, [{name: buffer, kind: register, reg: a0}, {name: capacity, kind: immediate, reg: a1}], "The bytes the host has sent over the API, oldest first, into the buffer, at most capacity; the bytes written, 0 with none waiting, and in a1 how many still wait, both 0 with no API port; never waits"],
    [jab.sys.png.size, 26, [{name: source, kind: register, reg: a0}, {name: length, kind: register, reg: a1}], "A PNG's width and height from its header, in a0 and a1, with a JAB_PNG_* code in a2: OK, or both 0 with NOT_PNG, TRUNCATED, CRC, or UNSUPPORTED"],
    [jab.sys.sprite.png, 27, [{name: sprite, kind: register, reg: a0}, {name: source, kind: register, reg: a1}, {name: length, kind: register, reg: a2}, {name: capacity, kind: immediate, reg: a3}, {name: frames, kind: immediate, reg: a4}], "Decode a PNG in place into the sprite record as a sheet of that many frames stacked top to bottom, with the span table; a JAB_PNG_* code: OK, FRAMES when the height does not divide, SIZE when the buffer is short of JAB_SPRITE_PIXELS + height * (width * 4 + 4), else what is wrong with the file"],
    [jab.sys.sprite.draw, 28, [{name: sprite, kind: register, reg: a0}, {name: frame, kind: register, reg: a1}, {name: x, kind: register, reg: a2}, {name: y, kind: register, reg: a3}, {name: tint, kind: register, reg: a4}, {name: scale, kind: register, reg: a5}, {name: pose, kind: register, reg: a6}], "Blend a frame of the sprite onto the framebuffer with its top left at x, y (signed; clipped at the edges), each pixel multiplied by the tint (0x00RRGGBB, JAB_SPRITE_PLAIN for none), the frame scaled in 256ths (JAB_SPRITE_SCALE_ONE for its own size), then mirrored by JAB_SPRITE_FLIP_H and JAB_SPRITE_FLIP_V in the pose and turned clockwise by the degrees in its low sixteen bits about its centre, or with JAB_SPRITE_SOLID the tint written over every pixel the frame covers; 0, 1 when the frame is not in the sprite, 2 when the scale is past JAB_SPRITE_SCALE_MAX; a record with a side or a frame count past 65535 ends the run"],
    [jab.sys.sprite.load, 29, [{name: sprite, kind: register, reg: a0}, {name: id, kind: register, reg: a1}, {name: path, kind: address, reg: a2}, {name: capacity, kind: immediate, reg: a3}], "Fill the sprite record from a directory on that disk: the files 0.png, 1.png, and on, in order until one is missing, each decoded off the disk into its own frame, all one size, with the span table; a JAB_PNG_* code: OK, NOT_FOUND when the directory or its 0.png is not there, FRAMES when a frame's size differs from the first's, SIZE when the buffer is short of JAB_SPRITE_PIXELS + frames * height * (width * 4 + 4), else a frame's own code"],
    [jab.sys.display.flip.rects, 30, [{name: buffer, kind: register, reg: a0}, {name: count, kind: register, reg: a1}], "Show that many rectangles of the framebuffer, JAB_RECT_SIZE bytes each from the buffer, as one flip without waiting, the host copying each and painting once the rectangle holding them all; jab.sys.display.flip's codes, plus 4 when the count is 0 or more than the window could hold, or any rectangle is empty or reaches outside the screen, nothing shown then"],
    [jab.sys.kernel.flags, 31, [], "The mask of what the kernel was built with: JAB_KERNEL_DEBUG at bit 0"],
    [jab.sys.pad.read, 32, [{name: record, kind: register, reg: a0}], "The pad's state into a JAB_PAD_ENTRY record: the keys held as a mask from BTN_GAMEPAD and every axis by its evdev code normalised to signed 16 bits, full scale JAB_PAD_FULL; 0, or 1 with no pad on the machine; brings the pad up on the first call"],
    [jab.sys.pad.input, 33, [], "The next pad event in evdev's terms: its type in a0, JAB_EV_KEY or JAB_EV_ABS, or 0 with none waiting; its code in a1; its value in a2, signed, raw as the pad sent it"],
    [jab.sys.pad.axis, 34, [{name: buffer, kind: register, reg: a0}, {name: code, kind: immediate, reg: a1}], "The pad's own range for that axis into a JAB_PAD_AXIS_ENTRY record: min, max, fuzz, flat, resolution, five signed 32-bit fields as virtio reports them; 0, 1 with no pad, 2 when the pad has no such axis"],
    [jab.sys.display.text, 35, [{name: message, kind: address, reg: a0}, {name: x, kind: register, reg: a1}, {name: y, kind: register, reg: a2}, {name: color, kind: register, reg: a3}, {name: style, kind: register, reg: a4}, {name: scale, kind: register, reg: a5}], "Draw a NUL-terminated string into the framebuffer with the console's font, its top left at x, y (signed; clipped), in the colour 0x00RRGGBB, the glyphs' own pixels only, JAB_TEXT_BOLD in the style striking each twice a pixel apart, the scale in 256ths sizing each cell; nothing presented; the width drawn in a0 and the height in a1"],
    [jab.sys.pad.name, 36, [{name: buffer, kind: register, reg: a0}], "The pad's name as the device reports it, NUL-terminated, into a buffer of JAB_PAD_NAME_BYTES; 0, or 1 with no pad on the machine; the length in a1"],
    [jab.sys.random, 37, [{name: buffer, kind: register, reg: a0}, {name: length, kind: register, reg: a1}], "That many random bytes from the machine's entropy device into the buffer; 0 with them written and in a1 how many the device gave, or 1 with no rng device on the machine; brings the device up on the first call"],
    [jab.sys.sound.open, 38, [], "Bring the sound device up with its playback stream started in the one format, 48 kHz stereo signed 16-bit interleaved, in periods of JAB_SOUND_PERIOD frames with JAB_SOUND_PERIODS in flight at most; 0, 1 with no sound device, 2 when the device refuses the kernel or the format"],
    [jab.sys.sound.write, 39, [{name: buffer, kind: register, reg: a0}, {name: frames, kind: register, reg: a1}], "That many frames from the buffer into the stream's ring of JAB_SOUND_RING frames, as many as it has room for, played in order as they reach the front; 0 with a1 how many were taken, or jab.sys.sound.open's code; opens the device on the first call"],
    [jab.sys.sound.ready, 40, [], "0 with a1 how many frames jab.sys.sound.write would take now, or jab.sys.sound.open's code"],
    [jab.sys.midi.program, 41, [{name: channel, kind: register, reg: a0}, {name: program, kind: register, reg: a1}], "The channel's instrument becomes that General MIDI program, 0 to 127, for the notes after; 0, or jab.sys.sound.open's code; opens the sound device on the first call, as every MIDI call does"],
    [jab.sys.midi.note, 42, [{name: channel, kind: register, reg: a0}, {name: note, kind: register, reg: a1}, {name: velocity, kind: register, reg: a2}, {name: on, kind: register, reg: a3}], "With on set and a velocity 1 to 127, the note, 0 to 127 with 69 the A at 440 Hz, starts on the channel with its instrument, taking one of JAB_MIDI_VOICES voices, the oldest when none is free; with on 0 or velocity 0, every voice sounding it on the channel goes to its release, or waits for the pedal; 0, or jab.sys.sound.open's code"],
    [jab.sys.midi.control, 43, [{name: channel, kind: register, reg: a0}, {name: control, kind: register, reg: a1}, {name: value, kind: register, reg: a2}], "The channel's controller takes the value, MIDI's numbers, 0 to 127: 7 volume, 10 pan, 11 expression, 64 the pedal (64 and up holds every note released until it lifts), 120 every voice off at once, 121 the controllers back to their defaults, 123 every note released; the rest taken without effect; 0, or jab.sys.sound.open's code"],
    [jab.sys.midi.bend, 44, [{name: channel, kind: register, reg: a0}, {name: value, kind: register, reg: a1}], "The channel's pitch bend, 14 bits with 8192 the centre, two semitones at either end, for the notes sounding and after; 0, or jab.sys.sound.open's code"],
    [jab.sys.midi.instrument, 45, [{name: program, kind: register, reg: a0}, {name: spec, kind: register, reg: a1}], "That General MIDI program, 0 to 127, plays the instrument the spec describes, JAB_MIDI_INSTRUMENT_ENTRY bytes inside the program's window: the wave, the square's duty, attack, decay, and release in milliseconds, sustain, vibrato depth and rate; 0, or jab.sys.sound.open's code"],
    [jab.sys.midi.silence, 46, [], "The piece stopped, every voice off at once, and every channel's controllers back to their defaults, the programs kept; 0, or jab.sys.sound.open's code"],
    [jab.sys.midi.play, 47, [{name: source, kind: register, reg: a0}, {name: length, kind: register, reg: a1}], "Play the Standard MIDI File of that many bytes at the source, inside the program's window and unchanged while it plays, format 0 or 1 with up to JAB_MIDI_TRACKS tracks and a division in ticks a quarter note: whatever was playing stops with its notes released; the file's notes, controllers, program changes, bends, and tempo changes go to the synthesizer a period at a time on the sound device's clock; 0, or jab.sys.sound.open's code, or 3 when the file is not one the player takes"],
    [jab.sys.midi.stop, 48, [], "The piece stops where it is, its notes released; 0, or jab.sys.sound.open's code"],
    [jab.sys.midi.playing, 49, [], "1 while a piece plays, else 0"],
    [jab.sys.midi.soundfont, 50, [{name: buffer, kind: register, reg: a0}, {name: length, kind: register, reg: a1}], "Play the notes after through the SoundFont 2 file of that many bytes at the buffer, inside the program's window on a 4-byte boundary and unchanged while loaded, read in place, the notes sounding stopped; a length of 0 unloads it and the chip-tune voices return; 0 with the presets, instruments, and samples in a1 to a3, or jab.sys.sound.open's code, 3 when the bytes are not a SoundFont 2 file, 4 when the file is unsound"],
    [jab.sys.harts, 51, [], "The machine's harts as three masks, bit n for hart n, below JAB_HARTS_MAX: in a0 those the device tree lists, in a1 those online, and in a2 those that failed. Every listed hart is one or the other once the kernel is up: a secondary is online once it has checked in, and failed, for the run, when a topology problem in the tree keeps it parked, when it has no interrupt file, when it misses the check-in's bound, when its own self-check breaks, or when it does not take a worker's start in time"],
    [jab.sys.worker.start, 52, [{name: hart, kind: register, reg: a0}, {name: entry, kind: address, reg: a1}, {name: argument, kind: register, reg: a2}, {name: stack, kind: register, reg: a3}, {name: size, kind: register, reg: a4}], "Start a worker on that hart, hart 0's call alone. The hart enters the program at the entry with a0 the argument, a1 its own id, sp the top of the stack, which is the size bytes from the stack's address, ra 0 so that returning from the entry faults, and every other register 0, its floating-point and vector state as a reset leaves it. The call returns once the hart has taken the start: 0, or 1 when the hart is not an online secondary, 2 when it already runs a worker, 3 when the entry is outside the program's window or odd, 4 when the stack is empty, not on 16 bytes, or outside the window, 5 when the stack reaches into JAB_MAIN_STACK's reservation under the window's top or into a running worker's stack, 6 when the hart did not take the start within its bound, failed for the run"],
    [jab.sys.worker.wait, 53, [{name: word, kind: register, reg: a0}, {name: value, kind: register, reg: a1}], "Sleep while the 32-bit word at that address, inside the program's window on 4 bytes, holds the value: 0 once the word differs, or 1 when a stop is asked of the calling worker, which is checked first, so a value the word does not hold asks whether a stop is pending without sleeping. Any hart may call it; on hart 0 it serves the devices while it sleeps, as jab.sys.await does"],
    [jab.sys.worker.wake, 54, [{name: mask, kind: register, reg: a0}], "Wake every hart in the mask that sleeps in jab.sys.worker.wait, after every store the caller made before the call; any hart may call it; the mask of the harts woken"],
    [jab.sys.worker.exit, 55, [], "End the calling worker: its hart leaves the program for good and waits for its next start, and hart 0 is woken; on hart 0 it answers JAB_DENIED"],
    [jab.sys.worker.stop, 56, [{name: mask, kind: register, reg: a0}], "Stop the workers in the mask, hart 0's call alone: each one's wait answers 1, and a worker still running 50 ms later is interrupted and stopped where it is. The call returns once every one has left the program for good, its stack and buffers free for reuse, and ends the run when one has not within a second more. In a0 the harts of the mask free of a worker, which is every online secondary in it whether its worker was stopped or had already ended, and in a1 those whose worker had to be interrupted"]
]
