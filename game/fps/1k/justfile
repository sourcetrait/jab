# Jab FPS for the 1K tier: the game, a Jab program outside the jab
# workspace, with everything it needs in this one directory: its source
# under src/, its tests and the fill-rate probe under test/, our content
# and the tools that render and compile it. Every program recipe hands
# off to the SDK's nushell tool, found through the manifest's `sdk`,
# which reads program.jab.toml and does the lookups (the workspace the
# manifest names, toolchain, target, kernel, display) and the up-to-date
# check; the test trees under .target/asset are laid out by conversion
# tooling outside the repository, and a missing one stops here. `--set
# debug` names the build symbols; `test` always sets DEBUG; `run --api`
# puts the API's port on the machine. From the jab root, `just run game
# fps 1k` runs the game through this file.

set shell := ["nu", "-c"]
set windows-shell := ["nu", "-c"]
set quiet := true

here := justfile_directory()
root := here / ".." / ".." / ".."
fillrate := here / "test" / "fillrate"

default: build

# Every asset under content/ rendered to the file beside it the engine
# reads: an SVG to a PNG at its own size through rust/svg2png, built
# when it is not there; an ambient note list to a MIDI file through
# nu/ambient.nu; a sound recipe to PCM through nu/sound.nu
render:
    let tool = "{{here}}/rust/target/release/svg2png"; if not ($tool | path exists) { ^cargo build --release --manifest-path "{{here}}/rust/Cargo.toml" }; for svg in (glob "{{here}}/content/**/*.svg") { ^$tool $svg ($svg | str replace --regex '\.svg$' '.png') }; for list in (glob "{{here}}/content/ambient/*.nuon") { ^nu "{{here}}/nu/ambient.nu" render $list ($list | str replace --regex '\.nuon$' '.mid') }; for recipe in (glob "{{here}}/content/sound/*.nuon") { ^nu "{{here}}/nu/sound.nu" render $recipe ($recipe | str replace --regex '\.nuon$' '.pcm') }

# Every map source under content/map compiled into .target/asset/<name>
# with its materials, ambients, counts, and plan views: the trees the
# program's recipes build on, the factory the manifest's assets
compile:
    for src in (glob "{{here}}/content/map/*.nuon") { ^nu "{{here}}/nu/map.nu" compile $src "{{here}}/.target/asset" }

# The sample trees the test puts on the machine itself, cage2 and
# doortest, laid out by the conversion tooling kept outside the
# repository; a missing one stops with its path
sample-trees:
    for m in [cage2 doortest] { if not ($"{{here}}/.target/asset/($m)/map.nuon" | path exists) { error make { msg: $"no test tree at {{here}}/.target/asset/($m); lay it out with the conversion tooling kept outside the repository" } } }

# Assemble and link src/main.S to .target/<tree>/<name>/<name>.jab when
# stale; release, or `just build --set debug`
build *args: compile
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") build "{{here}}" {{args}}

# Build with DEBUG set, then run test/test.nu on the debug kernel
test *args: compile sample-trees
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") test "{{here}}" {{args}}

# Build, then run on the kernel with the console window, the UART on
# stdio; the exit code is the program's status
run *args: compile
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") run "{{here}}" {{args}}

# Build with DEBUG set, or the symbols given with it, then capture a map
# from placed camera poses, a NUON list of {name, x, y, z, yaw, pitch},
# as PNGs under out: `just pose cage2 poses.nuon out`; `just pose factory
# poses.nuon out debug,owner` captures the surface each pixel belongs to
pose map poses out set='debug': compile
    ^just build --set {{set}}; ^nu "{{here}}/test/pose.nu" "{{map}}" "{{poses}}" "{{out}}" --kernel "{{root}}/.target/debug/kernel/jab.elf" --image "{{here}}/.target/debug/fps/fps.jab" --set {{set}}

# Build with DEBUG set, then play the factory on the pad from seeded
# random tables for that many seconds a seed, a fault resolved to its
# routine: `just smoke "[1 2 3]" 60`
smoke seeds='[1]' seconds='60': compile
    ^just build --set debug; ^nu "{{here}}/test/smoke.nu" --kernel "{{root}}/.target/debug/kernel/jab.elf" --image "{{here}}/.target/debug/fps/fps.jab" --out "{{here}}/.target/debug/fps/smoke" --seeds "{{seeds}}" --seconds {{seconds}}

# Build, then play the gauge's route (test/route_factory.nuon) on that
# build headless, every frame of each run read from the program's clock
# records, gauge.nuon written under the tree's gauge directory and the
# summary printed: `just gauge`, the release build three times; `just
# gauge debug 1`; `just gauge release 3 --host` in the host's window and
# audio
gauge tree='release' runs='3' *args:
    ^just build {{ if tree == "debug" { "--set debug" } else { "" } }}; ^nu "{{here}}/test/gauge.nu" run --tree {{tree}} --runs {{runs}} {{args}}

# Build, then put the factory in the host's window, with its audio and
# its own gamepad, for you to play; the measurement closes after that
# many seconds and the window with it: `just gauge-play 120`
gauge-play seconds='120' tree='release':
    ^just build {{ if tree == "debug" { "--set debug" } else { "" } }}; ^nu "{{here}}/test/gauge.nu" play --tree {{tree}} --seconds {{seconds}}

# Read a run's capture as the gauge reads its own, the identity its
# launch wrote beside it taken up: `just gauge-read <run>/api.out`
gauge-read api:
    ^nu "{{here}}/test/gauge.nu" read "{{api}}"

# Set builds' gauge.nuon files side by side, each walked leg per half
# metre of its path, the method and every bin kept in
# .target/compare.nuon: `just gauge-compare a/gauge.nuon b/gauge.nuon`
gauge-compare *files:
    ^nu "{{here}}/test/gauge.nu" compare {{files}}

# Build with DEBUG set, then hand the factory to robojab for an agent or
# a script to play: `just play` prints the MCP server line and config
# record for a subagent; `just play /tmp/fps.sock` serves commands on
# that socket in the foreground; `just play mcp cage2 300` another map
# and bound
play target='mcp' map='factory' seconds='600': compile
    ^just build --set debug; ^nu "{{here}}/test/play.nu" --kernel "{{root}}/.target/debug/kernel/jab.elf" --image "{{here}}/.target/debug/fps/fps.jab" --out "{{here}}/.target/debug/fps/play" --map "{{map}}" --seconds {{seconds}} --target "{{target}}"

# The fill-rate probe under test/fillrate, a program of its own built
# against the workspace the same way: what the hart draws a second, mode
# by mode: `just fillrate-test`, `just fillrate-test --set vector`,
# `just fillrate-run --no-pad --no-sound`
fillrate-build *args:
    cd "{{fillrate}}"; let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") build "{{fillrate}}" {{args}}

fillrate-test *args:
    cd "{{fillrate}}"; let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") test "{{fillrate}}" {{args}}

fillrate-run *args:
    cd "{{fillrate}}"; let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") run "{{fillrate}}" {{args}}

# A run's screen capture as a PNG to look at, every Nth pixel:
# `just shot .target/debug/fps/screen.ppm frame.png`
shot ppm png step="4":
    ^nu "{{here}}/nu/shot.nu" "{{ppm}}" "{{png}}" --step {{step}}

# Everything built here: both programs' trees, the asset trees, the
# gauge's runs, and the test trees laid out from the sample content
clean:
    rm -rf "{{here}}/.target" "{{fillrate}}/.target"
