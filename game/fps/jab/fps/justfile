# The game, a Jab program outside the jab workspace. Every recipe hands
# off to the SDK's nushell tool, found through the manifest's `sdk`,
# which reads program.jab.toml and does the lookups (the workspace the
# manifest names, toolchain, target, kernel, display) and the
# up-to-date check; the test trees under the game's .target/asset are
# laid out by conversion tooling outside the repository, and a missing
# one stops here. `--set debug` names the build symbols; `test` always
# sets DEBUG; `run --api` puts the API's port on the machine.

set shell := ["nu", "-c"]
set windows-shell := ["nu", "-c"]
set quiet := true

here := justfile_directory()
game := here / ".." / ".."

default: build

# The trees under the game's .target/asset: our own maps compiled from
# content/map, the factory the manifest's assets
assets:
    ^just --justfile "{{game}}/justfile" compile

# The sample trees the test puts on the machine itself, cage2 and
# doortest, laid out by the conversion tooling kept outside the
# repository; a missing one stops with its path
sample-trees:
    for m in [cage2 doortest] { if not ($"{{game}}/.target/asset/($m)/map.nuon" | path exists) { error make { msg: $"no test tree at {{game}}/.target/asset/($m); lay it out with the conversion tooling kept outside the repository" } } }

# Assemble and link src/main.S to .target/<tree>/<name>/<name>.jab when
# stale; release, or `just build --set debug`
build *args: assets
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") build "{{here}}" {{args}}

# Build with DEBUG set, then run test/test.nu on the debug kernel
test *args: assets sample-trees
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") test "{{here}}" {{args}}

# Build, then run on the kernel with the console window, the UART on
# stdio; the exit code is the program's status
run *args: assets
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") run "{{here}}" {{args}}

# Build with DEBUG set, or the symbols given with it, then capture a map
# from placed camera poses, a NUON list of {name, x, y, z, yaw, pitch},
# as PNGs under out: `just pose cage2 poses.nuon out`; `just pose factory
# poses.nuon out debug,owner` captures the surface each pixel belongs to
pose map poses out set='debug': assets
    ^just build --set {{set}}; ^nu "{{here}}/test/pose.nu" "{{map}}" "{{poses}}" "{{out}}" --kernel "{{game}}/../../.target/debug/kernel/jab.elf" --image "{{here}}/.target/debug/fps/fps.jab" --set {{set}}

# Build with DEBUG set, then play the factory on the pad from seeded
# random tables for that many seconds a seed, a fault resolved to its
# routine: `just smoke "[1 2 3]" 60`
smoke seeds='[1]' seconds='60': assets
    ^just build --set debug; ^nu "{{here}}/test/smoke.nu" --kernel "{{game}}/../../.target/debug/kernel/jab.elf" --image "{{here}}/.target/debug/fps/fps.jab" --out "{{here}}/.target/debug/fps/smoke" --seeds "{{seeds}}" --seconds {{seconds}}

# Build, then play the gauge's route (test/route_factory.nuon) on that
# build headless, every frame of each run read from the program's clock
# records, gauge.nuon written under the tree's gauge directory and the
# summary printed: `just gauge`, the release build three times; `just
# gauge debug 1`; `just gauge release 3 --host` in the host's window and
# audio
gauge tree='release' runs='3' *args: assets
    ^just build {{ if tree == "debug" { "--set debug" } else { "" } }}; ^nu "{{here}}/test/gauge.nu" run --tree {{tree}} --runs {{runs}} {{args}}

# Build, then put the factory in the host's window, with its audio and
# its own gamepad, for you to play; the measurement closes after that
# many seconds and the window with it: `just gauge-play 120`
gauge-play seconds='120' tree='release': assets
    ^just build {{ if tree == "debug" { "--set debug" } else { "" } }}; ^nu "{{here}}/test/gauge.nu" play --tree {{tree}} --seconds {{seconds}}

# Read a run's capture as the gauge reads its own, the identity its
# launch wrote beside it taken up: `just gauge-read <run>/api.out`
gauge-read api:
    ^nu "{{here}}/test/gauge.nu" read "{{api}}"

# Build with DEBUG set, then hand the factory to robojab for an agent or
# a script to play: `just play` prints the MCP server line and config
# record for a subagent; `just play /tmp/fps.sock` serves commands on
# that socket in the foreground; `just play mcp cage2 300` another map
# and bound
play target='mcp' map='factory' seconds='600': assets
    ^just build --set debug; ^nu "{{here}}/test/play.nu" --kernel "{{game}}/../../.target/debug/kernel/jab.elf" --image "{{here}}/.target/debug/fps/fps.jab" --out "{{here}}/.target/debug/fps/play" --map "{{map}}" --seconds {{seconds}} --target "{{target}}"

clean:
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") clean "{{here}}"
