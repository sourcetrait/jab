# A Jab program outside the jab workspace. Every recipe hands off to the
# SDK's nushell tool, found through the manifest's `sdk`, which reads
# program.jab.toml and does the lookups (the workspace the manifest
# names, toolchain, target, kernel, display) and the up-to-date check.
# `--set debug,vector` names the build symbols; `test` always sets
# DEBUG; `run --api` puts the API's port on the machine.

set shell := ["nu", "-c"]
set windows-shell := ["nu", "-c"]
set quiet := true

here := justfile_directory()

default: build

# Assemble and link src/main.S to .target/<tree>/<name>/<name>.jab when
# stale; release, or `just build --set debug`
build *args:
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") build "{{here}}" {{args}}

# Build with DEBUG set, then run test/test.nu on the debug kernel
test *args:
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") test "{{here}}" {{args}}

# Build, then run on the kernel with the console window, the UART on
# stdio; the exit code is the program's status
run *args:
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") run "{{here}}" {{args}}

clean:
    let sdk = (open program.jab.toml | get sdk); ^nu ($sdk | path join "nu" "jab.nu") clean "{{here}}"
