# footstep1: an android's foot on concrete, 0.18 seconds: a soft low
# sine thud falling in pitch, a triangle contact and a small square tap
# of the sole, a touch of noise for grit; footstep2 sits a little higher.
{
    seconds: 0.18,
    layers: [
        [wave, start, frequency, sweep, gain, attack, decay, sustain, release];
        [sine, 0.0, 105.0, 60.0, 0.30, 0.003, 0.07, 0.0, 0.0],
        [triangle, 0.0, 190.0, 150.0, 0.10, 0.001, 0.025, 0.0, 0.0],
        [square, 0.0, 420.0, 380.0, 0.035, 0.0, 0.01, 0.0, 0.0],
        [noise, 0.0, 0.0, 0.0, 0.05, 0.002, 0.035, 0.0, 0.0],
    ],
}
