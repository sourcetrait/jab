# servo: an android's joint turning, 0.35 seconds: two saws a few hertz
# apart sweeping up so the motor beats, a square an octave under for
# body, a faint gear whine eight times the motor, a hiss beneath, and a
# small triangle tick at 0.3 seconds as the joint stops.
{
    seconds: 0.35,
    layers: [
        [wave, start, frequency, sweep, gain, attack, decay, sustain, release];
        [saw, 0.0, 170.0, 330.0, 0.22, 0.015, 0.06, 0.75, 0.10],
        [saw, 0.0, 172.5, 336.0, 0.16, 0.015, 0.06, 0.75, 0.10],
        [square, 0.0, 85.0, 165.0, 0.07, 0.02, 0.06, 0.8, 0.10],
        [sine, 0.0, 1360.0, 2640.0, 0.035, 0.03, 0.05, 0.7, 0.10],
        [noise, 0.0, 0.0, 0.0, 0.06, 0.01, 0.08, 0.5, 0.10],
        [triangle, 0.3, 1900.0, 1900.0, 0.16, 0.0, 0.012, 0.0, 0.0],
    ],
}
