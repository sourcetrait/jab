# garage: the parking garage's ventilation, sixteen seconds looping: a
# hollow drone of a warm pad on a low F and its octave with a sweep pad
# an octave over, a helicopter patch pitched two octaves down for a
# fan's slow beating, three kalimba drips each with a faint echo, and
# one distant rumble of a low seashore wash. The drones and the fan are
# struck at 0 and 8 seconds on alternating channels, so the loop's seam
# is the same join as the one inside the piece.
{
    gain: 1.8,
    tracks: [
        {
            channel: 0, program: 89, volume: 84,
            notes: [
                [at, note, velocity, length];
                [0.0, 29, 62, 8.0],
                [0.0, 41, 44, 8.0],
            ],
        },
        {
            channel: 1, program: 89, volume: 84,
            notes: [
                [at, note, velocity, length];
                [8.0, 29, 62, 8.0],
                [8.0, 41, 44, 8.0],
            ],
        },
        {
