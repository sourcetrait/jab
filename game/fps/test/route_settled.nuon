# Render Zero's seven settled views as a gauge route, the settled gauge's
# poses read from the program's own records in any build: each view placed
# at its leg's start, a bare L 300 ms later, which forgets the tiles and
# lifts the quota, the allowance, and the merge's share, so the frame
# after the forget asks for the view's tiles and the next builds them
# all, then held. A view's settled frames are those after its leg's last
# frame building a tile. Played on the still copy, `--map
# render_0_still`, which has no androids. The frames before the first
# placement, the spawn's after the load, are their own leg, start.
{
    map: "render_0_still",
    end: 33000ms,
    legs: [
        { name: "start", places: [], pad: [] },
        { name: "spawn", places: [{ at: 1500ms, x: 29.0, y: 2.5, z: 1.6, yaw: 150, pitch: 0 }], sends: [{ at: 1800ms, kind: "L" }], pad: [] },
        { name: "yard", places: [{ at: 6000ms, x: 40.0, y: 6.0, z: 1.6, yaw: 90, pitch: 10 }], sends: [{ at: 6300ms, kind: "L" }], pad: [] },
        { name: "window", places: [{ at: 10500ms, x: 8.75, y: 17.0, z: 4.6, yaw: 0, pitch: -15 }], sends: [{ at: 10800ms, kind: "L" }], pad: [] },
        { name: "bay", places: [{ at: 15000ms, x: 20.0, y: 17.0, z: 1.6, yaw: 180, pitch: 5 }], sends: [{ at: 15300ms, kind: "L" }], pad: [] },
        { name: "up", places: [{ at: 19500ms, x: 8.75, y: 3.5, z: 1.6, yaw: 90, pitch: 15 }], sends: [{ at: 19800ms, kind: "L" }], pad: [] },
        { name: "down", places: [{ at: 24000ms, x: 1.5, y: 3.5, z: 1.6, yaw: 90, pitch: -15 }], sends: [{ at: 24300ms, kind: "L" }], pad: [] },
        { name: "garage", places: [{ at: 28500ms, x: 16.0, y: 14.0, z: -1.4, yaw: 0, pitch: 0 }], sends: [{ at: 28800ms, kind: "L" }], pad: [] },
    ],
}
